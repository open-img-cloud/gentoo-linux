#!/bin/bash
# Network, DNS and guest agent for the systemd Gentoo cloud image.

if [ "${DIB_DEBUG_TRACE:-0}" -gt 0 ]; then
    set -x
fi
set -eu
set -o pipefail

install -d -m 0755 /etc/systemd/network
cat > /etc/systemd/network/99-oic-dhcp.network <<'NET'
# Fallback: DHCP on every ethernet interface. cloud-init writes the
# OpenStack network configuration with a lower number, which wins.
[Match]
Type=ether

[Network]
DHCP=yes
NET

systemctl enable systemd-networkd.service systemd-resolved.service
ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
systemctl enable qemu-guest-agent.service
